# DO NOT TOUCH THE GLASS — runtime config (copy to .env, never commit .env)
# Real values for the live deployment are in the untracked GOLIVE.local.md.

# --- server ---
DNTTG_ADDR=:8080
DNTTG_DATA_DIR=data
DNTTG_BASE_URL=https://your-site.example.com
DNTTG_SITE_TITLE=DO NOT TOUCH THE GLASS
DNTTG_SITE_TAGLINE=INDEX
DNTTG_SITE_DESCRIPTION=a personal visual archive.   # also editable in admin → Settings
# DNTTG_DEV=1            # set for local http (disables Secure cookie flag)
# DNTTG_TRUST_PROXY=1  # set ONLY behind a trusted proxy/tunnel that overwrites
#                      # X-Forwarded-For or X-Real-IP. Spoofable otherwise.

# --- media / Cloudflare R2 (refined variants are mirrored here; originals stay local) ---
# Public media origin = the bucket's custom domain. Leave empty to serve /media locally.
DNTTG_MEDIA_BASE_URL=https://media.example.com
R2_BUCKET=your-bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- R2 rolling DB backups (SEPARATE, PRIVATE bucket — never the public media bucket) ---
R2_BACKUP_BUCKET=
DNTTG_BACKUP_RETENTION_DAYS=14
DNTTG_BACKUP_INTERVAL_HOURS=24

{
  "manifest_version": 3,
  "name": "DO NOT TOUCH THE GLASS",
  "version": "1.0.0",
  "description": "Save images, links, selections, and pages to your DNTTG archive.",
  "browser_specific_settings": {
    "gecko": { "id": "dttg@example.com", "strict_min_version": "115.0" },
    "gecko_android": {}
  },
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Save to the glass",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
}
